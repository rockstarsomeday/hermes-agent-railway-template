# Private-network only (no Railway domain or TCP proxy). Key login for one user.
Port 2222
ListenAddress ::
ListenAddress 0.0.0.0
HostKey /data/ssh/ssh_host_ed25519_key
AllowUsers hermes
PermitRootLogin no
PasswordAuthentication no
KbdInteractiveAuthentication no
PubkeyAuthentication yes
AuthorizedKeysFile /etc/ssh/authorized_keys/%u
UsePAM no
# No AcceptEnv: no environment variables are taken from the client.
AllowAgentForwarding no
AllowTcpForwarding no
X11Forwarding no
PermitTunnel no
GatewayPorts no
PrintMotd no
Subsystem sftp internal-sftp
